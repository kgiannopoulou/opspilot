# docker compose:   cp .env.example .env   (optional — compose reads this file, then .env on top of it)
# Local dev:        copy to backend/.env
# Database password for the compose stack (the API's connection string is built from it):
# POSTGRES_PASSWORD=opspilot
OPSPILOT_ENVIRONMENT=development
OPSPILOT_DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5438/opspilot
OPSPILOT_REDIS_URL=redis://localhost:6381/0
OPSPILOT_CORS_ORIGINS=["http://localhost:3010"]

# Authentication. Outside development the API refuses to start without a random secret of 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OPSPILOT_JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
OPSPILOT_ACCESS_TOKEN_MINUTES=15
OPSPILOT_REFRESH_TOKEN_DAYS=7
OPSPILOT_COOKIE_SECURE=false

# Observability. json = one JSON object per line with request ids (docker compose uses json).
OPSPILOT_LOG_FORMAT=text
# OPSPILOT_METRICS_TOKEN=   # if set, GET /metrics requires "Authorization: Bearer <token>"

# AI. The defaults need no keys: deterministic embeddings + extractive write-ups.
# Embeddings: hashing | fastembed (pip install -r backend/requirements-ml.txt)
OPSPILOT_EMBEDDING_PROVIDER=hashing
# Write-ups: none | anthropic (the Anthropic SDK then reads ANTHROPIC_API_KEY)
OPSPILOT_LLM_PROVIDER=none
OPSPILOT_LLM_MODEL=claude-opus-5-5
OPSPILOT_LLM_EFFORT=medium
# ANTHROPIC_API_KEY=
