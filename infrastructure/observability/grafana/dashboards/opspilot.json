      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(opspilot_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(opspilot_http_requests_total[5m])), 1e-9)",
